{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dust-up",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // warrick.games is the hub Worker's Custom Domain (../../hub); a route on it takes precedence.
  // vite.config.ts sets the matching base path and nests the built assets under dust-up/.
  "routes": [{ "pattern": "warrick.games/dust-up*", "zone_name": "warrick.games" }],
  // Serve only from warrick.games, so invite links always use it.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // Serve index.html for client-side routes like /dust-up/g/ABCDE.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/dust-up/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }]
}
