  // Workers runtime, the client the DOM and Vite) is checked by each game's own typecheck.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["vitest"]
  },
  "include": ["src/shared", "src/worker/lobby.ts", "test"]
}
