{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "warrick-games",
  "compatibility_date": "2026-10-01",
  // The hub owns warrick.games as a Custom Domain, so Cloudflare creates the apex DNS record and
  // certificate on deploy. Each game is its own Worker with a route on the same hostname, such as
  // warrick.games/crater-club*. Routes take precedence over a Custom Domain, so this Worker only
  // gets the paths no game claims.
  "routes": [{ "pattern": "warrick.games", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // No script: the hub is just static files.
  "assets": {
    "directory": "./public",
    // Unknown paths, including games that aren't deployed yet, get public/404.html.
    "not_found_handling": "404-page"
  }
}
