{
  "name": "warrick-games",
  "private": true,
  "type": "module",
  "workspaces": [
    "hub",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "share-cards": "node scripts/share-cards/generate.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "oxfmt": "0.71.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
